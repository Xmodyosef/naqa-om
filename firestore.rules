rules_version = '2';
/**
 * Naqa · Firestore security rules (LOCKED)
 * Collections:
 *   naqa/overrides  — product price/stock/hidden (public READ)
 *   naqa/reviews    — approved reviews (public READ)
 *
 * WRITE: only the admin UID listed below (signed-in).
 * Paste into Firebase Console → Firestore → Rules → Publish.
 * Adding a second admin: put their UID in adminUids() list.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    /** Hard lock: only these Firebase Auth UIDs may write. */
    function adminUids() {
      return [
        'a8z7XCtr63Xze6hKlloXyplju2i1'
      ];
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in adminUids();
    }

    function onlyKnownKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /naqa/overrides {
      allow read: if true;
      allow create, update: if isAdmin()
        && onlyKnownKeys(['map', 'updatedAt', 'updatedBy'])
        && request.resource.data.map is map
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /naqa/reviews {
      allow read: if true;
      allow create, update: if isAdmin()
        && onlyKnownKeys(['list', 'updatedAt', 'updatedBy'])
        && request.resource.data.list is list
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
