rules_version = '2';
/**
 * Naqa · Firestore security rules (source of truth on GitHub)
 * Deploy: push this file to main → Actions «Deploy Firestore rules»
 *    or paste into Firebase Console → Firestore → Rules → Publish
 *
 * Collections (store + admin):
 *   naqa/overrides      — price / stock / hidden / imgs …  PUBLIC read · admin write
 *   naqa/reviews        — approved reviews list             PUBLIC read · admin write
 *   naqa/orders_private — admin orders bag                  ADMIN only (no public)
 *   naqa_imgs/{id}      — optional image blobs              PUBLIC read · admin write
 *
 * Store (xmodyosef.github.io/naqa-om) only READs overrides + reviews.
 * Admin panel (admin.html) WRITEs after Firebase Auth as UID in adminUids().
 *
 * Updated: 2026-11-25 (store focus + GitHub source of truth)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    /** Only these Firebase Auth UIDs may write. Add second admin UID here. */
    function adminUids() {
      return [
        'a8z7XCtr63Xze6hKlloXyplju2i1'
      ];
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in adminUids();
    }

    function onlyKnownKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    /** updatedAt = epoch ms number; updatedBy must match signed-in UID */
    function stampOk() {
      /* Client may send Date.now() (number) or FieldValue.serverTimestamp() (timestamp). */
      return (request.resource.data.updatedAt is number
          || request.resource.data.updatedAt is timestamp)
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    /* —— Public store: live product overrides (hide / price / stock) —— */
    match /naqa/overrides {
      allow read: if true;
      allow create, update: if isAdmin()
        && onlyKnownKeys(['map', 'updatedAt', 'updatedBy'])
        && request.resource.data.map is map
        && stampOk();
      allow delete: if false;
    }

    /* —— Public store: customer reviews shown on site —— */
    match /naqa/reviews {
      allow read: if true;
      allow create, update: if isAdmin()
        && onlyKnownKeys(['list', 'updatedAt', 'updatedBy'])
        && request.resource.data.list is list
        && stampOk();
      allow delete: if false;
    }

    /* —— Admin only: private orders sync between admin devices —— */
    match /naqa/orders_private {
      allow read, create, update: if isAdmin()
        && onlyKnownKeys(['list', 'updatedAt', 'updatedBy'])
        && request.resource.data.list is list
        && stampOk();
      allow delete: if false;
    }

    /* —— Optional product image payloads (public read for store) —— */
    match /naqa_imgs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && onlyKnownKeys(['jpeg', 'updatedAt', 'updatedBy'])
        && request.resource.data.jpeg is string
        && request.resource.data.jpeg.size() > 20
        && request.resource.data.jpeg.size() < 700000
        && stampOk();
      allow delete: if false;
    }

    /* Deny everything else */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
